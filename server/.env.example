# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/telegram_rewards

# Telegram Bot Credentials (Get from @BotFather)
# Required for cryptographic HMAC-SHA256 signature verification
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Session & Cookie Security
# Secure random 32+ byte string used for signing session cookies
SESSION_SECRET=super_secret_session_key_at_least_32_chars_long

# CORS & Frontend Origin
FRONTEND_URL=http://localhost:3000

# Rate Limiting (max authentication attempts per minute per IP)
AUTH_RATE_LIMIT=10
